<Window x:Class="StorageManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZipXP · Storage Manager" Width="1390" Height="890" MinWidth="1050" MinHeight="720"
        Background="#F4F6F8" Foreground="#182C40" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#152B3F">
            <DockPanel Margin="20,28,12,20">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,34">
                    <TextBlock Text="zipxp" Foreground="White" FontSize="36" FontWeight="Bold" />
                    <TextBlock Text="STORAGE MANAGER" Foreground="#9FB7C8" FontSize="10" FontWeight="SemiBold" Margin="0,5" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Native NTFS compression" Foreground="#BBCBD7" TextWrapping="Wrap" Margin="5,0,0,7" />
                    <TextBlock Text="Your files stay in place." Foreground="#9FB7C8" Margin="5,0,0,18" />
                    <Button Content="Exit after current file" Click="Exit_Click" />
                </StackPanel>
                <StackPanel>
                    <Button Content="Overview" Tag="0" Click="Navigate_Click" HorizontalContentAlignment="Left" />
                    <Button Content="Managed folders" Tag="1" Click="Navigate_Click" HorizontalContentAlignment="Left" />
                    <Button Content="Storage insights" Tag="2" Click="Navigate_Click" HorizontalContentAlignment="Left" />
                    <Button Content="Activity" Tag="3" Click="Navigate_Click" HorizontalContentAlignment="Left" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="26,24,26,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="StartupBox" Content="Start at sign-in" Click="Startup_Click" VerticalAlignment="Center" Margin="0,0,20,8" />
                    <Button x:Name="PauseButton" Content="Pause all" Click="Pause_Click" />
                </StackPanel>
                <StackPanel><TextBlock Text="Make room. Keep your files." FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Automatic compression with visible policies and measured results." Foreground="#607487" Margin="0,5,0,0" /></StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="White" BorderBrush="#DCE5EB" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,14">
                <TextBlock x:Name="Banner" Text="Add a folder for read-only analysis. Enable a policy when you are ready." TextWrapping="Wrap" />
            </Border>
            <DockPanel Grid.Row="2" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Measured period" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <ComboBox x:Name="PeriodBox" Width="110" SelectedIndex="1" SelectionChanged="Period_Changed"><ComboBoxItem Content="Last 7 days" /><ComboBoxItem Content="Last 30 days" /><ComboBoxItem Content="All recorded" /></ComboBox>
                </StackPanel>
                <TextBlock Text="Folder" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="RootPicker" DisplayMemberPath="Path" SelectionChanged="Root_Changed" MinWidth="250" />
            </DockPanel>
            <TabControl x:Name="Pages" Grid.Row="3" BorderThickness="0" Background="Transparent">
                <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style></TabControl.Resources>
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Border Background="White" Padding="18" CornerRadius="7" Margin="0,0,12,0"><StackPanel><TextBlock Text="MANAGED ALLOCATION" Foreground="#607487" FontSize="11" /><TextBlock x:Name="AllocatedCard" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10" /><TextBlock x:Name="ScopeCard" Text="Primary streams · last scans" Foreground="#607487" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Background="White" Padding="18" CornerRadius="7" Margin="0,0,12,0"><StackPanel><TextBlock Text="ESTIMATED OPPORTUNITY" Foreground="#607487" FontSize="11" /><TextBlock x:Name="EstimateCard" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10" /><TextBlock Text="Sample-based estimate, not a promise" Foreground="#607487" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Background="#E5F3ED" Padding="18" CornerRadius="7"><StackPanel><TextBlock Text="NET MEASURED REDUCTION" Foreground="#3B6C58" FontSize="11" /><TextBlock x:Name="MeasuredCard" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10" /><TextBlock x:Name="MeasuredCaption" Text="Signed successful job measurements" Foreground="#3B6C58" TextWrapping="Wrap" /></StackPanel></Border>
                            </UniformGrid>
                            <Border Background="White" Padding="18" CornerRadius="7" Margin="0,0,0,16">
                                <StackPanel><TextBlock Text="Volume usage" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="VolumesText" Text="No managed volumes yet." Margin="0,10,0,0" TextWrapping="Wrap" /><TextBlock Text="Live volume free space includes other applications; it is separate from managed-folder accounting." Foreground="#607487" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Border Background="White" Padding="18" CornerRadius="7" Margin="0,0,0,16">
                                <StackPanel><TextBlock Text="Allocated storage history" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="HistoryCaption" Text="Choose a folder. Each bar is a scan; amber bars have incomplete coverage." Foreground="#607487" Margin="0,5,0,10" TextWrapping="Wrap" /><Canvas x:Name="HistoryChart" Height="150" ClipToBounds="True" SizeChanged="Chart_SizeChanged" /><TextBlock x:Name="HistoryRange" Foreground="#607487" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <Border Background="White" Padding="18" CornerRadius="7"><StackPanel><TextBlock Text="Background activity" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ActivityCard" Text="No jobs." Margin="0,10" TextWrapping="Wrap" /><TextBlock Text="Close this window to keep the tray worker running. Pause stops new work; Exit waits for the current file and ends the worker." Foreground="#607487" TextWrapping="Wrap" /></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Managed folders">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <WrapPanel x:Name="FolderActions">
                            <Button Content="Add folder…" Click="Add_Click" /><Button Content="Analyze now" Click="Analyze_Click" /><Button Content="Edit policy…" Click="Policy_Click" />
                            <Button Content="Pause / resume folder" Click="FolderPause_Click" /><Button Content="Compress now…" Tag="Compress" Click="ScopeJob_Click" />
                            <Button Content="Decompress folder…" Tag="Decompress" Click="ScopeJob_Click" /><Button Content="Clear native defaults…" Tag="ClearDefault" Click="ScopeJob_Click" /><Button Content="Stop managing" Click="Remove_Click" />
                        </WrapPanel>
                        <DataGrid x:Name="FoldersGrid" Grid.Row="1" SelectionChanged="FolderGrid_Changed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="2*" />
                                <DataGridTextColumn Header="Policy" Binding="{Binding Policy}" Width="115" />
                                <DataGridTextColumn Header="Logical" Binding="{Binding Logical}" Width="100" />
                                <DataGridTextColumn Header="Allocated" Binding="{Binding Allocated}" Width="100" />
                                <DataGridTextColumn Header="Candidates" Binding="{Binding Candidates}" Width="100" />
                                <DataGridTextColumn Header="Status / coverage" Binding="{Binding Status}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="New folders start in analysis-only mode. Enabling a policy authorizes compression within its scope. Stopping management leaves compressed files in place." TextWrapping="Wrap" Foreground="#607487" Margin="0,12" />
                    </Grid>
                </TabItem>
                <TabItem Header="Storage insights">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="Up" Click="InsightUp_Click" /><Button Content="Largest files" Click="Largest_Click" /><Button Content="Decompress selected…" Click="SelectedDecompress_Click" /></StackPanel><TextBox x:Name="InsightSearch" TextChanged="InsightSearch_Changed" ToolTip="Search filenames and reasons" MinWidth="120" Margin="0,0,0,8" /></DockPanel>
                        <TextBlock Grid.Row="1" x:Name="DrillPath" Text="Choose a managed folder." TextWrapping="Wrap" Margin="0,0,0,10" />
                        <DataGrid Grid.Row="2" x:Name="InsightsGrid" MouseDoubleClick="Insight_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="65" />
                                <DataGridTextColumn Header="Logical" Binding="{Binding Logical}" Width="100" /><DataGridTextColumn Header="Allocated" Binding="{Binding Allocated}" Width="100" />
                                <DataGridTextColumn Header="Compression" Binding="{Binding Compression}" Width="110" /><DataGridTextColumn Header="Reason / estimate" Binding="{Binding Reason}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="3" Text="Double-click a folder to drill down. Totals deduplicate observed hard links within each scope. Excluded subtrees, unknown entries, named streams and directory metadata are not included. Displays up to 500 rows." TextWrapping="Wrap" Foreground="#607487" Margin="0,12" />
                    </Grid>
                </TabItem>
                <TabItem Header="Activity">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel><Button DockPanel.Dock="Left" Content="Retry selected failures" Click="Retry_Click" /><ComboBox x:Name="StateFilter" DockPanel.Dock="Left" SelectedIndex="0" Width="120" Margin="0,0,8,8" SelectionChanged="ActivityFilter_Changed"><ComboBoxItem Content="All" /><ComboBoxItem Content="Pending" /><ComboBoxItem Content="Failed" /><ComboBoxItem Content="Succeeded" /><ComboBoxItem Content="Skipped" /><ComboBoxItem Content="Unchanged" /></ComboBox><TextBox x:Name="ActivitySearch" TextChanged="ActivitySearch_Changed" ToolTip="Search job paths, outcomes and errors" Margin="0,0,0,8" /></DockPanel>
                        <DataGrid Grid.Row="1" x:Name="JobsGrid" SelectionChanged="Job_Changed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="125" /><DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="100" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" /><DataGridTextColumn Header="Original path" Binding="{Binding Path}" Width="2*" />
                                <DataGridTextColumn Header="Reduction" Binding="{Binding DeltaDisplay}" Width="100" /><DataGridTextColumn Header="Result" Binding="{Binding Message}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox Grid.Row="2" x:Name="JobDetails" IsReadOnly="True" Height="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" AutomationProperties.Name="Copyable job diagnostics" />
                    </Grid>
                </TabItem>
            </TabControl>
            <StackPanel Grid.Row="4" Margin="0,14,0,0">
                <ProgressBar x:Name="BusyBar" Height="4" Margin="0,0,0,8" />
                <TextBlock x:Name="WorkerText" Text="Starting worker…" TextWrapping="Wrap" />
                <TextBlock Text="Primary-stream accounting only. Positive reduction means less allocation; negative means growth. Estimates and volume free-space changes are separate." Foreground="#607487" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
