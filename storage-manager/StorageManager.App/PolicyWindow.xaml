<Window x:Class="StorageManager.App.PolicyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder settings" Icon="Assets/zipxp.ico" Width="640" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="Number" TargetType="TextBox">
            <Setter Property="Width" Value="84" /><Setter Property="Margin" Value="0,4" /><Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Right" /><Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Plain box: no clear button, and an invalid (red) border stays red while the box has focus. -->
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom" Margin="1,0,1,0" CornerRadius="1" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusLine" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="Tag" Value="Invalid"><Setter TargetName="FocusLine" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                    <Button Content="Save" IsDefault="True" Click="Save_Click" MinWidth="96" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
                <!-- Hidden (not Collapsed) so showing a message never changes the dialog's layout. -->
                <Border x:Name="ErrorHost" Visibility="Hidden" CornerRadius="6" Padding="12,6" Margin="0,0,16,0" VerticalAlignment="Center" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                    <DockPanel>
                        <TextBlock Text="&#xEA39;" Style="{StaticResource Glyph}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,10,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="13" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
        <DockPanel Margin="24,20,24,12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock x:Name="FolderTitle" Style="{StaticResource PageTitle}" FontSize="24" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FolderPath" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,14,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="EnableBox" Content="Auto-compress this folder" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="28,2,0,12"
                                   Text="Compresses files that are worth it, now and when new ones appear. Files keep their names and places and open as usual." />
                        <CheckBox x:Name="BatteryBox" Content="Keep working when the PC is running on battery" Margin="28,0,0,12"
                                  IsEnabled="{Binding IsChecked, ElementName=EnableBox}" />
                        <CheckBox x:Name="RecursiveBox" Content="Include folders inside this one" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14,6,14,10" Margin="0,0,0,12"><Expander x:Name="AdvancedExpander" AutomationProperties.Name="Advanced options" IsExpanded="False" Margin="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                    <Expander.Resources>
                        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderContentBackgroundBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                    </Expander.Resources>
                    <Expander.Header>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="Advanced options" FontWeight="SemiBold" />
                            <TextBlock Text="Most people can leave these as they are." Style="{StaticResource Muted}" FontSize="13" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                <Border Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Which files" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" MinWidth="120" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Skip files smaller than" Style="{StaticResource Field}" />
                            <TextBox x:Name="MinimumBox" Grid.Column="1" Style="{StaticResource Number}" AutomationProperties.Name="Skip files smaller than, in kilobytes" />
                            <TextBlock x:Name="MinHint" Text="KB · at least 64" Grid.Column="2" Style="{StaticResource Unit}" />
                            <TextBlock x:Name="MinMsg" Grid.Row="1" Visibility="Collapsed" FontSize="13" TextWrapping="Wrap" Grid.ColumnSpan="3" Margin="0,0,0,6" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="Skip files larger than" Grid.Row="2" Style="{StaticResource Field}" />
                            <TextBox x:Name="MaximumBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Number}" AutomationProperties.Name="Skip files larger than, in megabytes" />
                            <TextBlock x:Name="MaxHint" Text="MB · up to 256" Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" />
                            <TextBlock x:Name="MaxMsg" Grid.Row="3" Visibility="Collapsed" FontSize="13" TextWrapping="Wrap" Grid.ColumnSpan="3" Margin="0,0,0,6" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="Skip files that would save less than" Grid.Row="4" Style="{StaticResource Field}" />
                            <TextBox x:Name="SavingBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource Number}" AutomationProperties.Name="Minimum saving, in kilobytes" />
                            <TextBlock Text="KB · 0 or more" Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}" />
                        </Grid>
                        <TextBlock Text="Never compress these" Margin="0,14,0,2" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,8" Text="Skipped by default because they are already compressed, or change too often to be worth it." />
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="PhotosBox" Content="Photos and images (JPG, PNG)" />
                            <CheckBox x:Name="VideosBox" Content="Videos (MP4)" />
                            <CheckBox x:Name="ArchivesBox" Content="Archives (ZIP, 7z)" />
                            <CheckBox x:Name="DevBox" Content="Programming tool folders" ToolTip="node_modules and .git folders" />
                        </UniformGrid>
                        <TextBlock Text="Anything else to skip (optional)" Margin="0,10,0,6" />
                        <TextBox x:Name="ExclusionsBox" MinHeight="40" AcceptsReturn="False" TextWrapping="Wrap" AutomationProperties.Name="Anything else to skip" ToolTip="For example: *.iso; cache/*" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"
                                   Text="Separate names with semicolons. Use * for &quot;anything&quot;, for example *.iso; cache/*." />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="When to work" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" MinWidth="120" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="After a file changes, wait before compressing it" Style="{StaticResource Field}" />
                            <TextBox x:Name="QuietBox" Grid.Column="1" Style="{StaticResource Number}" AutomationProperties.Name="Wait after a file changes, in seconds" />
                            <TextBlock Text="seconds" Grid.Column="2" Style="{StaticResource Unit}" />
                            <TextBlock Text="After handling a file, leave it alone for" Grid.Row="1" Style="{StaticResource Field}" />
                            <TextBox x:Name="CooldownBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Number}" AutomationProperties.Name="Leave a handled file alone, in seconds" />
                            <TextBlock Text="seconds" Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" />
                            <TextBlock Text="Always keep this much of the drive free" Grid.Row="2" Style="{StaticResource Field}" />
                            <TextBox x:Name="ReserveBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Number}" AutomationProperties.Name="Free space to keep, in megabytes" />
                            <TextBlock x:Name="ReserveHint" Text="MB · at least 256" Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" />
                            <TextBlock x:Name="ReserveMsg" Grid.Row="3" Visibility="Collapsed" FontSize="13" TextWrapping="Wrap" Grid.ColumnSpan="3" Margin="0,0,0,6" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Grid>
                        <CheckBox x:Name="AnyTimeBox" Content="Work at any time of day" Margin="0,12,0,0" Checked="AnyTime_Changed" Unchecked="AnyTime_Changed" />
                        <StackPanel x:Name="HoursPanel" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Only work from" Style="{StaticResource Field}" />
                            <ComboBox x:Name="StartBox" Width="96" AutomationProperties.Name="Start time" />
                            <TextBlock Text="until" Style="{StaticResource Unit}" Margin="12,0" />
                            <ComboBox x:Name="EndBox" Width="96" AutomationProperties.Name="End time" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"
                                   Text="For example, 10 PM until 6 AM works overnight, when you're probably not using the PC." />
                    </StackPanel>
                </Border>

                        <Button x:Name="RestoreButton" Content="Restore recommended settings" HorizontalAlignment="Left" Margin="0,0,0,4" Click="Restore_Click"
                                ToolTip="Put the size limits, schedule and skipped file types back to ZipXP's recommended values." />
                    </StackPanel>
                </Expander></Border>

                <Border x:Name="InheritanceHost" Visibility="Collapsed" CornerRadius="6" Padding="14,12" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock x:Name="InheritanceText" TextWrapping="Wrap" LineHeight="19" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
