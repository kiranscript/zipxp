<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- Compile the actual app service sources without a WPF/runtime dependency. -->
  <ItemGroup>
    <Compile Include="../StorageExplorer/Models/**/*.cs" Link="Models/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../StorageExplorer/Native/**/*.cs" Link="Native/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../StorageExplorer/Services/**/*.cs" Link="Services/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
