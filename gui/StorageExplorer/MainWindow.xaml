<Window x:Class="StorageExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Storage Explorer · NTFS alpha" Width="1180" Height="780"
        MinWidth="860" MinHeight="620" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="ChooseButton" Content="Choose folder…" Click="Choose_Click" />
            <Button x:Name="UpButton" Content="Up" Click="Up_Click" IsEnabled="False" />
            <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" IsEnabled="False" />
            <TextBox x:Name="PathBox" IsReadOnly="True" VerticalContentAlignment="Center"
                     Text="Choose a disposable local NTFS test folder" AutomationProperties.Name="Current folder" />
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="CompressButton" Content="Compress selected" Click="Compress_Click" IsEnabled="False" />
            <Button x:Name="DecompressButton" Content="Decompress selected" Click="Decompress_Click" IsEnabled="False" />
            <Button x:Name="OpenButton" Content="Open" Click="Open_Click" IsEnabled="False" />
            <Button x:Name="StopButton" Content="Stop after current file" Click="Stop_Click" IsEnabled="False" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <CheckBox x:Name="DirectoryDefault" Content="Compress newly created files in this folder"
                      Click="DirectoryDefault_Click" IsEnabled="False" />
            <TextBlock Margin="20,6,0,0" TextWrapping="Wrap" Foreground="#444444"
                       Text="Applies to new files and new subfolders. Existing files and existing subfolders are unchanged. Files moved here may retain their previous setting. This setting remains active when the app is closed." />
            <TextBlock Margin="20,4,0,0" TextWrapping="Wrap" Foreground="#444444"
                       Text="Manual compression: 64 KiB–256 MiB. Decompression: up to 256 MiB. The native folder default does not enforce these limits on future files." />
        </StackPanel>
        <Border Grid.Row="3" Background="#EEF3F8" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Choose a folder to begin. Files keep their original names and open normally, even with this app closed." />
        </Border>
        <Grid Grid.Row="4">
            <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                      SelectionChanged="Selection_Changed" MouseDoubleClick="FileGrid_DoubleClick"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="65" />
                    <DataGridTextColumn Header="Logical size" Binding="{Binding LogicalSize}" Width="110" CanUserSort="False" />
                    <DataGridTextColumn Header="Allocated size" Binding="{Binding AllocatedSize}" Width="110" CanUserSort="False" />
                    <DataGridTextColumn Header="Compression" Binding="{Binding Compression}" Width="115" />
                    <DataGridTextColumn Header="Result / eligibility" Binding="{Binding Result}" Width="3*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Result}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="No files or folders here." Visibility="Collapsed"
                       IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555555" />
        </Grid>
        <StackPanel Grid.Row="5" Margin="0,10,0,8">
            <TextBlock Text="Selected entry details / compact diagnostics" Margin="0,0,0,4" />
            <TextBox Text="{Binding SelectedItem.Result, ElementName=FileGrid, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap" Height="75" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Selected entry details" />
        </StackPanel>
        <StackPanel Grid.Row="6">
            <ProgressBar x:Name="JobBar" Height="5" Margin="0,0,0,8" Minimum="0" Maximum="1" />
            <TextBlock x:Name="JobText" Text="No operation running." TextWrapping="Wrap" />
            <TextBlock x:Name="CurrentFileText" TextWrapping="Wrap" Margin="0,3,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="#555555" Margin="0,6,0,0"
                       Text="Allocation measures the primary data stream only; directory metadata and named streams are excluded. A positive reduction means less allocated space; negative means growth. This is not whole-volume free-space recovery." />
        </StackPanel>
    </Grid>
</Window>
